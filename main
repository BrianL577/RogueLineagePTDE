local Window = Library:CreateWindow({
    Title = "Embark Utility",
    Footer = "Flight, ESP, Spectate & Night",
    Icon = 0,
    NotifySide = "Right",
    ShowCustomCursor = true,
})

local Tabs = {
    Movement = Window:AddTab("Movement", "user"),
    Visuals = Window:AddTab("Visuals", "eye"),
    ["UI Settings"] = Window:AddTab("UI Settings", "settings"),
}

local MovementGroup = Tabs.Movement:AddLeftGroupbox("Flight Controls")
local PhysicsGroup = Tabs.Movement:AddRightGroupbox("Physics & Speed")
