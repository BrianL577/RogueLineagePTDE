-- TRINKET DICTIONARY
--------------------------------------------------------------------------------
local TRINKET_DICTIONARY = {
    -- COMMONS (White)
    ["rbxassetid://5204453430"] = { Name = "Scroll", Color = Color3.fromRGB(255, 255, 255), Rarity = "Common" },
    ["rbxassetid://5196551436"] = { Name = "Amulet/Opal", Color = Color3.fromRGB(255, 255, 255), Rarity = "Common" },
    ["rbxassetid://5196776695"] = { Name = "Ring", Color = Color3.fromRGB(255, 255, 255), Rarity = "Common" },
    ["rbxassetid://5196782997"] = { Name = "Ring", Color = Color3.fromRGB(255, 255, 255), Rarity = "Common" },
    ["rbxassetid://5196577540"] = { Name = "Amulet2", Color = Color3.fromRGB(255, 255, 255), Rarity = "Common" },
    ["rbxassetid://5204003946"] = { Name = "Goblet", Color = Color3.fromRGB(255, 255, 255), Rarity = "Common" },
    ["rbxassetid://2877143560"]  = { Name = "Ruby", Color = Color3.fromRGB(255, 255, 255), Rarity = "Common" },
    
    -- RARES (Orange)
    ["rbxassetid://30942623"]   = { Name = "Astral Shard", Color = Color3.fromRGB(255, 140, 0), Rarity = "Rare" },
    ["rbxassetid://7030942623"] = { Name = "Shard", Color = Color3.fromRGB(255, 140, 0), Rarity = "Rare" },

    -- MISC / SPECIAL
    ["rbxassetid://4027112893"] = { Name = "Particle", Color = Color3.fromRGB(255, 255, 255), Rarity = "Common" },
    ["rbxassetid://2520762076"] = { Name = "Howler Friend", Color = Color3.fromRGB(255, 255, 255), Rarity = "Common" },
}

local unknownMeshIDs = {}

local function identifyTrinket(instance)
    local meshId = ""
    
    if instance:IsA("MeshPart") then
        meshId = instance.MeshId
    else
        local specialMesh = instance:FindFirstChildWhichIsA("SpecialMesh", true)
        if specialMesh then
            meshId = specialMesh.MeshId
        end
    end

    meshId = string.gsub(meshId, "%%20", "")
    meshId = string.gsub(meshId, "%s+", "")

    if TRINKET_DICTIONARY[meshId] then
        local item = TRINKET_DICTIONARY[meshId]
        return item.Name, item.Color, item.Rarity
    elseif meshId ~= "" then
        if not unknownMeshIDs[meshId] then
            unknownMeshIDs[meshId] = true
        end
        return "Unknown (" .. string.sub(meshId, -8) .. ")", Color3.fromRGB(255, 50, 50), "Unknown"
    end

    return "Trinket", Color3.fromRGB(255, 255, 255), "Common"
end

--------------------------------------------------------------------------------
-- 1. FLIGHT LOGIC (OPTIMIZED)
--------------------------------------------------------------------------------
local flying = false
local flySpeed = 50

local function fly()
    while flying do
        local character = LocalPlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        
        if root then
            local moveDirection = Vector3.zero
            local cameraCFrame = Camera.CFrame
            local isMoving = false

            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDirection = moveDirection + cameraCFrame.LookVector isMoving = true end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDirection = moveDirection - cameraCFrame.LookVector isMoving = true end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDirection = moveDirection - cameraCFrame.RightVector isMoving = true end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDirection = moveDirection + cameraCFrame.RightVector isMoving = true end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDirection = moveDirection + Vector3.new(0, 1, 0) isMoving = true end

            if isMoving and moveDirection.Magnitude > 0 then
                root.AssemblyLinearVelocity = moveDirection.Unit * flySpeed
            else
                root.AssemblyLinearVelocity = Vector3.zero
            end
        end

        RunService.RenderStepped:Wait()
    end
end

local FlyToggle = MovementGroup:AddToggle('FlyToggle', {
    Text = 'Fly',
    Tooltip = 'Fly around the map',
    Default = false,
    Callback = function(Value)
        flying = Value
        if flying then
            task.spawn(fly)
        else
            local character = LocalPlayer.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            if root then root.AssemblyLinearVelocity = Vector3.zero end
        end
    end
})

FlyToggle:AddKeyPicker("FlyKeybind", { Default = "LeftAlt", SyncToggleState = true, Mode = "Toggle", Text = "Fly Keybind" })

MovementGroup:AddSlider('FlySpeed', {
    Text = 'Fly Speed', Default = 50, Min = 10, Max = 300, Rounding = 0,
    Callback = function(Value) flySpeed = Value end
})

