local noclip = false
local noclipConnection = nil

local NoClipToggle = PhysicsGroup:AddToggle('NoClipToggle', {
    Text = 'NoClip', Default = false,
    Callback = function(Value)
        noclip = Value
        if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end
        
        if noclip then
            noclipConnection = RunService.Stepped:Connect(function()
                local character = LocalPlayer.Character
                if character then
                    for _, part in ipairs(character:GetChildren()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                end
            end)
        end
    end
})

NoClipToggle:AddKeyPicker("NoClipKeybind", { Default = "KeypadPlus", SyncToggleState = true, Mode = "Toggle", Text = "NoClip Keybind" })

--------------------------------------------------------------------------------
-- 3. REMOTE DESTRUCTION NOFALL LOGIC (EVENT-BASED OPTIMIZATION)
--------------------------------------------------------------------------------
local noFallRemoteEnabled = false
local noFallCharConnection = nil

local function hookNoFall(character)
    if not character then return end
    local charHandler = character:WaitForChild("CharacterHandler", 3)
    local remotes = charHandler and charHandler:WaitForChild("Remotes", 3)
    if remotes then
        local fallRemote = remotes:FindFirstChild("ApplyFallDamage")
        if fallRemote then fallRemote:Destroy() end

        remotes.ChildAdded:Connect(function(child)
            if noFallRemoteEnabled and child.Name == "ApplyFallDamage" then
                child:Destroy()
            end
        end)
    end
end

PhysicsGroup:AddToggle('NoFallRemoteToggle', {
    Text = 'No Fall (Destroy Remote)', Default = false,
    Callback = function(Value)
        noFallRemoteEnabled = Value
        if noFallCharConnection then noFallCharConnection:Disconnect() noFallCharConnection = nil end

        if noFallRemoteEnabled then
            if LocalPlayer.Character then hookNoFall(LocalPlayer.Character) end
            noFallCharConnection = LocalPlayer.CharacterAdded:Connect(function(char)
                task.wait(0.5)
                if noFallRemoteEnabled then hookNoFall(char) end
            end)
        end
    end
})

--------------------------------------------------------------------------------
-- 4. CLIENT-SIDE ALWAYS NIGHT LOGIC
--------------------------------------------------------------------------------
local alwaysNightEnabled = false
local nightConnection = nil
local originalClockTime = Lighting.ClockTime

LightingGroup:AddToggle('AlwaysNightToggle', {
    Text = 'Always Night', Default = false,
    Callback = function(Value)
        alwaysNightEnabled = Value
        if alwaysNightEnabled then
            originalClockTime = Lighting.ClockTime
            Lighting.ClockTime = 0
            nightConnection = RunService.RenderStepped:Connect(function()
                if alwaysNightEnabled and Lighting.ClockTime ~= 0 then Lighting.ClockTime = 0 end
            end)
        else
            if nightConnection then nightConnection:Disconnect() nightConnection = nil end
            Lighting.ClockTime = originalClockTime
        end
    end
})

--------------------------------------------------------------------------------
-- 5. LEADERBOARD SPECTATE SYSTEM (ROBUST MATCHING)
--------------------------------------------------------------------------------
local spectateEnabled = true
local spectatingPlayerName = nil
local playerRPNameCache = {}

-- Helper to safely clean string inputs
local function sanitizeName(str)
    if not str then return "" end
    -- Remove non-standard whitespace and trailing/leading spaces
    return string.lower(string.gsub(tostring(str), "^%s*(.-)%s*$", "%1"))
end

local function updatePlayerCache(player)
    if not player then return end
    
    -- Recursive search inside player for FirstName and LastName StringValues
    local firstNameVal = player:FindFirstChild("FirstName", true)
    local lastNameVal = player:FindFirstChild("LastName", true)

    local firstName = firstNameVal and sanitizeName(firstNameVal.Value) or ""
    local lastName = lastNameVal and sanitizeName(lastNameVal.Value) or ""

    -- Store full name ("first last")
    if firstName ~= "" and lastName ~= "" then
        playerRPNameCache[firstName .. " " .. lastName] = player
    end

    -- Store individual first and last names as fallbacks
    if firstName ~= "" then playerRPNameCache[firstName] = player end
    if lastName ~= "" then playerRPNameCache[lastName] = player end

    -- Store account username as fallback
    playerRPNameCache[sanitizeName(player.Name)] = player
    playerRPNameCache[sanitizeName(player.DisplayName)] = player
end

local function refreshAllPlayerCaches()
    table.clear(playerRPNameCache)
    for _, player in ipairs(Players:GetPlayers()) do 
        updatePlayerCache(player) 
    end
end

-- Force refresh cache on player changes
Players.PlayerAdded:Connect(updatePlayerCache)
Players.PlayerRemoving:Connect(function(player)
    refreshAllPlayerCaches()
end)

refreshAllPlayerCaches()

local function resetSpectateCamera()
    local liveFolder = Workspace:FindFirstChild("Live") or Workspace
    local char = LocalPlayer.Character or liveFolder:FindFirstChild(LocalPlayer.Name)
    local hum = char and char:FindFirstChildWhichIsA("Humanoid")
    if hum then
        Camera.CameraType = Enum.CameraType.Custom
        Camera.CameraSubject = hum
    end
    spectatingPlayerName = nil
end

local function resolvePlayerFromText(rawText)
    local cleanText = sanitizeName(rawText)
    if cleanText == "" then return nil end

    -- Direct cache lookup
    if playerRPNameCache[cleanText] then
        return playerRPNameCache[cleanText]
    end

    -- Fallback 1: Dynamic re-scan of all players in case values updated late
    refreshAllPlayerCaches()
    if playerRPNameCache[cleanText] then
        return playerRPNameCache[cleanText]
    end

    -- Fallback 2: Substring / Partial match search
    for rpName, playerObj in pairs(playerRPNameCache) do
        if string.find(rpName, cleanText, 1, true) or string.find(cleanText, rpName, 1, true) then
            return playerObj
        end
    end

    return nil
end

local function hookLeaderboardSpectate()
    local playerGui = LocalPlayer:WaitForChild("PlayerGui", 10)
    local leaderboardGui = playerGui and playerGui:WaitForChild("LeaderboardGui", 10)
    local mainFrame = leaderboardGui and leaderboardGui:WaitForChild("MainFrame", 10)
    local scrollFrame = mainFrame and mainFrame:WaitForChild("ScrollingFrame", 10)
    if not scrollFrame then return end

    local function setupEntry(entry)
        if not entry:IsA("GuiObject") then return end

        entry.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton2 and spectateEnabled then
                local label = entry:IsA("TextLabel") and entry or entry:FindFirstChildWhichIsA("TextLabel", true)
                if not label or label.Text == "" then return end
                
                local rpNameText = label.Text
                if spectatingPlayerName == rpNameText then
                    resetSpectateCamera()
                    Library:Notify({ Title = "Spectate", Description = "Reset camera to self", Time = 2 })
                    return
                end

                local targetPlayer = resolvePlayerFromText(rpNameText)

                if not targetPlayer then
                    Library:Notify({ Title = "Spectate Error", Description = "Could not resolve player: " .. rpNameText, Time = 3 })
                    return
                end

                local liveFolder = Workspace:FindFirstChild("Live") or Workspace
                local targetChar = liveFolder:FindFirstChild(targetPlayer.Name)
                local cameraSubject = targetChar and (targetChar:FindFirstChildWhichIsA("Humanoid") or targetChar:FindFirstChild("HumanoidRootPart"))

                if cameraSubject then
                    Camera.CameraType = Enum.CameraType.Custom
                    Camera.CameraSubject = cameraSubject
                    spectatingPlayerName = rpNameText
                    Library:Notify({ Title = "Spectating", Description = "Spectating: " .. targetPlayer.Name, Time = 2 })
                else
                    Library:Notify({ Title = "Spectate Error", Description = targetPlayer.Name .. " model not found in Workspace.Live", Time = 3 })
                end
            end
        end)
    end

    for _, child in ipairs(scrollFrame:GetChildren()) do setupEntry(child) end
    scrollFrame.ChildAdded:Connect(setupEntry)
end

task.spawn(hookLeaderboardSpectate)

SpectateGroup:AddToggle('LeaderboardSpectateToggle', {
    Text = 'Leaderboard Spectate', Default = true,
    Callback = function(Value)
        spectateEnabled = Value
        if not Value then resetSpectateCamera() end
    end
})

SpectateGroup:AddButton({ Text = 'Reset Camera', Func = resetSpectateCamera })

--------------------------------------------------------------------------------
-- 6. ADVANCED PLAYER BOX ESP (CULLED & OPTIMIZED)
--------------------------------------------------------------------------------
local boxEspEnabled = false
local boxEspColor = Color3.fromRGB(0, 255, 140)
local espObjects = {}

local function createEspDrawing(player)
    if player == LocalPlayer then return end

    local box = Drawing.new("Square") box.Visible = false box.Color = boxEspColor box.Thickness = 1.5
    local nameText = Drawing.new("Text") nameText.Visible = false nameText.Color = Color3.fromRGB(255, 255, 255) nameText.Size = 14 nameText.Center = true nameText.Outline = true
    local hpText = Drawing.new("Text") hpText.Visible = false hpText.Size = 13 hpText.Center = true hpText.Outline = true

    espObjects[player] = { Box = box, Name = nameText, HP = hpText }
end

for _, player in ipairs(Players:GetPlayers()) do createEspDrawing(player) end
Players.PlayerAdded:Connect(createEspDrawing)
Players.PlayerRemoving:Connect(function(player)
    if espObjects[player] then
        espObjects[player].Box:Remove() espObjects[player].Name:Remove() espObjects[player].HP:Remove()
        espObjects[player] = nil
    end
end)

RunService.RenderStepped:Connect(function()
    if not boxEspEnabled then
        for _, esp in pairs(espObjects) do
            esp.Box.Visible = false esp.Name.Visible = false esp.HP.Visible = false
        end
        return
    end

    local liveFolder = Workspace:FindFirstChild("Live") or Workspace

    for player, esp in pairs(espObjects) do
        local character = player.Character or liveFolder:FindFirstChild(player.Name)
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildWhichIsA("Humanoid")

        if character and root and humanoid and humanoid.Health > 0 then
            local position, onScreen = Camera:WorldToViewportPoint(root.Position)

            if onScreen then
                local head = character:FindFirstChild("Head")
                local headPos = head and Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or Camera:WorldToViewportPoint(root.Position + Vector3.new(0, 3, 0))
                local legPos = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))

                local height = math.abs(headPos.Y - legPos.Y)
                local width = height / 1.5

                esp.Box.Size = Vector2.new(width, height)
                esp.Box.Position = Vector2.new(position.X - width / 2, position.Y - height / 2)
                esp.Box.Color = boxEspColor
                esp.Box.Visible = true

                esp.Name.Text = player.Name
                esp.Name.Position = Vector2.new(position.X, position.Y - height / 2 - 16)
                esp.Name.Visible = true

                local currentHp = math.floor(humanoid.Health)
                local maxHp = math.floor(humanoid.MaxHealth)
                esp.HP.Text = string.format("HP: %d/%d", currentHp, maxHp)
                esp.HP.Position = Vector2.new(position.X, position.Y + height / 2 + 2)
                esp.HP.Visible = true
            else
                esp.Box.Visible = false esp.Name.Visible = false esp.HP.Visible = false
            end
        else
            esp.Box.Visible = false esp.Name.Visible = false esp.HP.Visible = false
        end
    end
end)

PlayerEspGroup:AddToggle('PlayerBoxEspToggle', {
    Text = 'Enable Player Box ESP', Default = false,
    Callback = function(Value) boxEspEnabled = Value end
}):AddColorPicker('PlayerBoxEspColor', {
    Default = Color3.fromRGB(0, 255, 140), Title = 'Box ESP Color',
    Callback = function(Value) boxEspColor = Value end
})

--------------------------------------------------------------------------------
-- 7. TRINKET ESP & AUTOPICKUP LOGIC (THROTTLED & OPTIMIZED)
--------------------------------------------------------------------------------
local trinketEspEnabled = false
local trinketMaxDistance = 150
local showCommons = true
local showRares = true
local showUnknowns = true
local activeTrinketESP = {}

local autoPickupEnabled = false

local function createTrinketBillboard(instance)
    if activeTrinketESP[instance] then return end
    
    local part = instance:IsA("BasePart") and instance or instance:FindFirstChildWhichIsA("BasePart", true)
    if not part then return end

    local name, color, rarity = identifyTrinket(instance)

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "TrinketESP"
    billboard.Adornee = part
    billboard.Size = UDim2.new(0, 50, 0, 15)
    billboard.StudsOffset = Vector3.new(0, 1, 0)
    billboard.AlwaysOnTop = true
    billboard.Enabled = false

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = name
    textLabel.TextColor3 = color
    textLabel.TextStrokeTransparency = 0.5
    textLabel.TextSize = 9
    textLabel.Font = Enum.Font.SourceSansBold
    textLabel.Parent = billboard

    billboard.Parent = part
    activeTrinketESP[instance] = { Gui = billboard, Part = part, Rarity = rarity }

    instance.AncestryChanged:Connect(function(_, parent)
        if not parent and activeTrinketESP[instance] then
            if activeTrinketESP[instance].Gui then activeTrinketESP[instance].Gui:Destroy() end
            activeTrinketESP[instance] = nil
        end
    end)
end

-- Dedicated 10 Hz throttled thread for Trinket ESP updates (Prevents FPS drop)
task.spawn(function()
    while true do
        task.wait(0.1)
        local liveFolder = Workspace:FindFirstChild("Live")
        local char = LocalPlayer.Character or (liveFolder and liveFolder:FindFirstChild(LocalPlayer.Name))
        local root = char and char:FindFirstChild("HumanoidRootPart")

        if trinketEspEnabled and root then
            local rootPos = root.Position
            for _, data in pairs(activeTrinketESP) do
                if data and data.Gui and data.Part and data.Part.Parent then
                    local dist = (rootPos - data.Part.Position).Magnitude
                    
                    local passesFilter = false
                    if data.Rarity == "Common" and showCommons then passesFilter = true end
                    if data.Rarity == "Rare" and showRares then passesFilter = true end
                    if data.Rarity == "Unknown" and showUnknowns then passesFilter = true end

                    data.Gui.Enabled = passesFilter and (dist <= trinketMaxDistance)
                end
            end
        else
            for _, data in pairs(activeTrinketESP) do
                if data and data.Gui then data.Gui.Enabled = false end
            end
        end
    end
end)

-- Dedicated 6 Hz throttled thread for Auto Pickup (Prevents frame spikes)
task.spawn(function()
    while true do
        task.wait(0.15)
        if autoPickupEnabled then
            local liveFolder = Workspace:FindFirstChild("Live")
            local char = LocalPlayer.Character or (liveFolder and liveFolder:FindFirstChild(LocalPlayer.Name))
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local dinketsFolder = Workspace:FindFirstChild("Dinkets")

            if root and dinketsFolder then
                local rootPos = root.Position
                for _, item in ipairs(dinketsFolder:GetChildren()) do
                    local part = item:IsA("BasePart") and item or item:FindFirstChildWhichIsA("BasePart", true)
                    if part then
                        if (rootPos - part.Position).Magnitude <= 20 then
                            local clickDetector = item:FindFirstChildWhichIsA("ClickDetector", true)
                            if clickDetector then fireclickdetector(clickDetector, 0) end
                        end
                    end
                end
            end
        end
    end
end)

local function scanForTrinkets()
    local dinketsFolder = Workspace:WaitForChild("Dinkets", 10)
    if dinketsFolder then
        for _, child in ipairs(dinketsFolder:GetChildren()) do createTrinketBillboard(child) end
        dinketsFolder.ChildAdded:Connect(function(child)
            task.wait(0.1)
            createTrinketBillboard(child)
        end)
    end
end
task.spawn(scanForTrinkets)

WorldEspGroup:AddToggle('TrinketEspToggle', { Text = 'Enable Trinket ESP', Default = false, Callback = function(V) trinketEspEnabled = V end })
WorldEspGroup:AddSlider('TrinketEspDistance', { Text = 'Trinket ESP Distance', Default = 150, Min = 10, Max = 500, Rounding = 0, Callback = function(V) trinketMaxDistance = V end })
WorldEspGroup:AddToggle('ShowCommonsToggle', { Text = 'Show Common Trinkets', Default = true, Callback = function(V) showCommons = V end })
WorldEspGroup:AddToggle('ShowRaresToggle', { Text = 'Show Rare Trinkets (Orange)', Default = true, Callback = function(V) showRares = V end })
WorldEspGroup:AddToggle('ShowUnknownsToggle', { Text = 'Show Unknown Trinkets (Red)', Default = true, Callback = function(V) showUnknowns = V end })

local AutoPickupToggle = WorldEspGroup:AddToggle('AutoPickupToggle', {
    Text = 'Auto Pickup (20 Studs)', Default = false,
    Callback = function(Value) autoPickupEnabled = Value end
})
AutoPickupToggle:AddKeyPicker("AutoPickupKeybind", { Default = "E", SyncToggleState = true, Mode = "Toggle", Text = "Auto Pickup Keybind" })

