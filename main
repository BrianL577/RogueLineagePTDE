local AutoPickupToggle = WorldEspGroup:AddToggle('AutoPickupToggle', {
    Text = 'Auto Pickup (20 Studs)',
    Tooltip = 'Continuously sweeps Workspace.Dinkets and clicks items within 20 studs',
    Default = false,
    Callback = function(Value)
        autoPickupEnabled = Value
        
        if autoPickupConnection then
            autoPickupConnection:Disconnect()
            autoPickupConnection = nil
        end

        if autoPickupEnabled then
            autoPickupConnection = RunService.Heartbeat:Connect(function()
                local char = LocalPlayer.Character or (Workspace:FindFirstChild("Live") and Workspace.Live:FindFirstChild(LocalPlayer.Name))
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local dinketsFolder = Workspace:FindFirstChild("Dinkets")

                if root and dinketsFolder then
                    for _, item in ipairs(dinketsFolder:GetChildren()) do
                        local part = item:IsA("BasePart") and item or item:FindFirstChildWhichIsA("BasePart", true)
                        if part then
                            local distance = (root.Position - part.Position).Magnitude
                            if distance <= 20 then
                                local clickDetector = item:FindFirstChildWhichIsA("ClickDetector", true)
                                if clickDetector then
                                    fireclickdetector(clickDetector, 0)
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
})

AutoPickupToggle:AddKeyPicker("AutoPickupKeybind", {
    Default = "E",
    SyncToggleState = true,
    Mode = "Toggle",
    Text = "Auto Pickup Keybind",
    NoUI = false,
})

WorldEspGroup:AddButton({
    Text = 'Print Unknown Mesh IDs',
    Func = function()
        print("=== UNKNOWN TRINKET MESH IDS ===")
        for id in pairs(unknownMeshIDs) do
            print(id)
        end
        Library:Notify({
            Title = "Mesh IDs Logged",
            Description = "Logged unknown IDs to Developer Console (F9)",
            Time = 4
        })
    end
})

--------------------------------------------------------------------------------
-- 8. INITIALIZE LIBRARY MANAGERS & SCALABLE CONFIG SYSTEM
--------------------------------------------------------------------------------
ThemeManager:SetLibrary(Library)
SaveManager:SetLibrary(Library)

-- Ensure no core keybinds are ignored so user loadouts save everything
SaveManager:SetIgnoreIndexes({})

ThemeManager:SetFolder('EmbarkScript')
SaveManager:SetFolder('EmbarkScript/configs')

SaveManager:BuildConfigSection(Tabs['UI Settings'])
ThemeManager:ApplyToTab(Tabs['UI Settings'])

local MenuGroup = Tabs['UI Settings']:AddLeftGroupbox('Menu Controls')

MenuGroup:AddLabel('Toggle Keybind'):AddKeyPicker('MenuKeybind', {
    Default = 'RightShift',
    NoUI = false,
    Text = 'UI Toggle Key',
    Callback = function()
        Library:Toggle()
    end
})

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed then
        local keyPicker = Options and Options.MenuKeybind
        if keyPicker and input.KeyCode == keyPicker.Value then
            Library:Toggle()
        end
    end
end)

-- Automatically apply autoload configs if saved by the user
SaveManager:LoadAutoloadConfig()

Library:Notify({
    Title = "Embark Utility Loaded",
    Description = "Full config support enabled. All keybinds and settings ready to save.",
    Time = 4
})
