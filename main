--------------------------------------------------------------------------------
-- 3. REMOTE DESTRUCTION NOFALL LOGIC
--------------------------------------------------------------------------------
local noFallRemoteEnabled = false
local noFallScanConnection = nil

local function destroyFallDamageRemote(character)
    if not character then return end
    
    local charHandler = character:WaitForChild("CharacterHandler", 2)
    if charHandler then
        local remotes = charHandler:WaitForChild("Remotes", 2)
        if remotes then
            local fallRemote = remotes:FindFirstChild("ApplyFallDamage")
            if fallRemote then
                fallRemote:Destroy()
            end
            
            remotes.ChildAdded:Connect(function(child)
                if noFallRemoteEnabled and child.Name == "ApplyFallDamage" then
                    child:Destroy()
                end
            end)
        end
    end
end

PhysicsGroup:AddToggle('NoFallRemoteToggle', {
    Text = 'No Fall (Destroy Remote)',
    Tooltip = 'Deletes ApplyFallDamage remote from CharacterHandler',
    Default = false,
    Callback = function(Value)
        noFallRemoteEnabled = Value
        
        if noFallRemoteEnabled then
            for _, folderName in ipairs({"Live", "Dead"}) do
                local folder = Workspace:FindFirstChild(folderName)
                if folder then
                    local char = folder:FindFirstChild(LocalPlayer.Name)
                    if char then destroyFallDamageRemote(char) end
                end
            end
            
            noFallScanConnection = RunService.Heartbeat:Connect(function()
                for _, folderName in ipairs({"Live", "Dead"}) do
                    local folder = Workspace:FindFirstChild(folderName)
                    if folder then
                        local char = folder:FindFirstChild(LocalPlayer.Name)
                        if char then
                            local remote = char:FindFirstChild("CharacterHandler") and char.CharacterHandler:FindFirstChild("Remotes") and char.CharacterHandler.Remotes:FindFirstChild("ApplyFallDamage")
                            if remote then remote:Destroy() end
                        end
                    end
                end
            end)
        else
            if noFallScanConnection then
                noFallScanConnection:Disconnect()
                noFallScanConnection = nil
            end
        end
    end
})

