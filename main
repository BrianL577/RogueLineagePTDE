-- 4. CLIENT-SIDE ALWAYS NIGHT LOGIC
--------------------------------------------------------------------------------
local alwaysNightEnabled = false
local nightConnection = nil
local originalClockTime = Lighting.ClockTime

LightingGroup:AddToggle('AlwaysNightToggle', {
    Text = 'Always Night',
    Tooltip = 'Forces local client lighting to midnight (00:00)',
    Default = false,
    Callback = function(Value)
        alwaysNightEnabled = Value
        
        if alwaysNightEnabled then
            originalClockTime = Lighting.ClockTime
            Lighting.ClockTime = 0
            
            nightConnection = RunService.RenderStepped:Connect(function()
                if alwaysNightEnabled and Lighting.ClockTime ~= 0 then
                    Lighting.ClockTime = 0
                end
            end)
        else
            if nightConnection then
                nightConnection:Disconnect()
                nightConnection = nil
            end
            Lighting.ClockTime = originalClockTime
        end
    end
})

--------------------------------------------------------------------------------
-- 5. LEADERBOARD SPECTATE SYSTEM (OPTIMIZED)
--------------------------------------------------------------------------------
local spectateEnabled = true
local spectatingPlayerName = nil

-- Cache for mapping "FirstName LastName" -> Player instance
local playerRPNameCache = {}

local function updatePlayerCache(player)
    if not player then return end
    
    local firstNameVal = player:FindFirstChild("FirstName", true)
    local lastNameVal = player:FindFirstChild("LastName", true)

    local firstName = firstNameVal and tostring(firstNameVal.Value) or ""
    local lastName = lastNameVal and tostring(lastNameVal.Value) or ""

    local fullName = string.lower(string.format("%s %s", firstName, lastName))
    fullName = string.gsub(fullName, "^%s*(.-)%s*$", "%1") -- trim whitespace

    if fullName ~= "" then
        playerRPNameCache[fullName] = player
    end
    playerRPNameCache[string.lower(player.Name)] = player
end

local function refreshAllPlayerCaches()
    table.clear(playerRPNameCache)
    for _, player in ipairs(Players:GetPlayers()) do
        updatePlayerCache(player)
    end
end

-- Refresh cache on player join/leave
Players.PlayerAdded:Connect(updatePlayerCache)
Players.PlayerRemoving:Connect(function(player)
    for rpName, cachedPlayer in pairs(playerRPNameCache) do
        if cachedPlayer == player then
            playerRPNameCache[rpName] = nil
        end
    end
end)

refreshAllPlayerCaches()

local function resetSpectateCamera()
    local liveFolder = Workspace:FindFirstChild("Live")
    local char = LocalPlayer.Character or (liveFolder and liveFolder:FindFirstChild(LocalPlayer.Name))
    local hum = char and char:FindFirstChildWhichIsA("Humanoid")
    if hum then
        Camera.CameraType = Enum.CameraType.Custom
        Camera.CameraSubject = hum
    end
    spectatingPlayerName = nil
end

local function hookLeaderboardSpectate()
    local playerGui = LocalPlayer:WaitForChild("PlayerGui", 10)
    if not playerGui then return end
    
    local leaderboardGui = playerGui:WaitForChild("LeaderboardGui", 10)
    if not leaderboardGui then return end
    
    local mainFrame = leaderboardGui:WaitForChild("MainFrame", 10)
    local scrollFrame = mainFrame and mainFrame:WaitForChild("ScrollingFrame", 10)
    if not scrollFrame then return end

    local function setupEntry(entry)
        if not entry:IsA("GuiObject") then return end

        -- Single listener on the top-level entry frame instead of all descendants
        entry.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton2 and spectateEnabled then
                local label = entry:IsA("TextLabel") and entry or entry:FindFirstChildWhichIsA("TextLabel")
                if not label then return end
                
                local rpNameText = label.Text
                if rpNameText == "" then return end
                
                if spectatingPlayerName == rpNameText then
                    resetSpectateCamera()
                    Library:Notify({ Title = "Spectate", Description = "Reset camera to self", Time = 2 })
                    return
                end

                local cleanName = string.lower(string.gsub(rpNameText, "^%s*(.-)%s*$", "%1"))
                
                -- O(1) Cache Lookup instead of recursive search
                local targetPlayer = playerRPNameCache[cleanName]
                
                -- Fallback cache update if missing
                if not targetPlayer then
                    refreshAllPlayerCaches()
                    targetPlayer = playerRPNameCache[cleanName]
                end

                if not targetPlayer then
                    Library:Notify({ Title = "Spectate Error", Description = "Could not resolve: " .. rpNameText, Time = 3 })
                    return
                end

                local liveFolder = Workspace:FindFirstChild("Live") or Workspace
                local targetChar = liveFolder:FindFirstChild(targetPlayer.Name)
                
                if targetChar then
                    local cameraSubject = targetChar:FindFirstChildWhichIsA("Humanoid") or targetChar:FindFirstChild("HumanoidRootPart")

                    if cameraSubject then
                        Camera.CameraType = Enum.CameraType.Custom
                        Camera.CameraSubject = cameraSubject
                        spectatingPlayerName = rpNameText
                        Library:Notify({ Title = "Spectating", Description = "Spectating: " .. rpNameText, Time = 2 })
                    end
                else
                    Library:Notify({ Title = "Spectate Error", Description = targetPlayer.Name .. " not in Workspace.Live", Time = 3 })
                end
            end
        end)
    end

    for _, child in ipairs(scrollFrame:GetChildren()) do 
        setupEntry(child) 
    end
    scrollFrame.ChildAdded:Connect(setupEntry)
end

task.spawn(hookLeaderboardSpectate)

SpectateGroup:AddToggle('LeaderboardSpectateToggle', {
    Text = 'Leaderboard Spectate',
    Tooltip = 'Right-click player labels on leaderboard to spectate HRP in Workspace.Live',
    Default = true,
    Callback = function(Value)
        spectateEnabled = Value
        if not Value then resetSpectateCamera() end
    end
})

SpectateGroup:AddButton({
    Text = 'Reset Camera',
    Func = function()
        resetSpectateCamera()
    end
})
--------------------------------------------------------------------------------
-- 6. ADVANCED PLAYER BOX ESP
--------------------------------------------------------------------------------
local boxEspEnabled = false
local boxEspColor = Color3.fromRGB(0, 255, 140)
local espObjects = {}

local function getPlayerClass(player, character)
    if not character then return "None" end
    local classAttr = character:GetAttribute("Class") or character:GetAttribute("Archetype") or player:GetAttribute("Class")
    if classAttr then return tostring(classAttr) end
    
    local classVal = character:FindFirstChild("Class") or character:FindFirstChild("Archetype")
    if classVal and (classVal:IsA("StringValue") or classVal:IsA("ObjectValue")) then
        return tostring(classVal.Value)
    end
    return "Unknown"
end

local function createEspDrawing(player)
    if player == LocalPlayer then return end

    local box = Drawing.new("Square")
    box.Visible = false
    box.Color = boxEspColor
    box.Thickness = 1.5
    box.Filled = false
    box.Transparency = 1

    local nameText = Drawing.new("Text")
    nameText.Visible = false
    nameText.Color = Color3.fromRGB(255, 255, 255)
    nameText.Size = 14
    nameText.Center = true
    nameText.Outline = true

    local hpText = Drawing.new("Text")
    hpText.Visible = false
    hpText.Size = 13
    hpText.Center = true
    hpText.Outline = true

    local classText = Drawing.new("Text")
    classText.Visible = false
    classText.Color = Color3.fromRGB(255, 200, 50)
    classText.Size = 12
    classText.Center = true
    classText.Outline = true

    espObjects[player] = { Box = box, Name = nameText, HP = hpText, Class = classText }
end

for _, player in ipairs(Players:GetPlayers()) do createEspDrawing(player) end
Players.PlayerAdded:Connect(createEspDrawing)

Players.PlayerRemoving:Connect(function(player)
    if espObjects[player] then
        espObjects[player].Box:Remove()
        espObjects[player].Name:Remove()
        espObjects[player].HP:Remove()
        espObjects[player].Class:Remove()
        espObjects[player] = nil
    end
end)

RunService.RenderStepped:Connect(function()
    if not boxEspEnabled then
        for _, esp in pairs(espObjects) do
            esp.Box.Visible = false
            esp.Name.Visible = false
            esp.HP.Visible = false
            esp.Class.Visible = false
        end
        return
    end

    for player, esp in pairs(espObjects) do
        local character = player.Character or (Workspace:FindFirstChild("Live") and Workspace.Live:FindFirstChild(player.Name))
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildWhichIsA("Humanoid")

        if character and root and humanoid and humanoid.Health > 0 then
            local position, onScreen = Camera:WorldToViewportPoint(root.Position)

            if onScreen then
                local head = character:FindFirstChild("Head")
                local headPos = head and Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or Camera:WorldToViewportPoint(root.Position + Vector3.new(0, 3, 0))
                local legPos = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))

                local height = math.abs(headPos.Y - legPos.Y)
                local width = height / 1.5

                local boxX = position.X - width / 2
                local boxY = position.Y - height / 2

                esp.Box.Size = Vector2.new(width, height)
                esp.Box.Position = Vector2.new(boxX, boxY)
                esp.Box.Color = boxEspColor
                esp.Box.Visible = true

                esp.Name.Text = player.Name
                esp.Name.Position = Vector2.new(position.X, boxY - 16)
                esp.Name.Visible = true

                local currentHp = math.floor(humanoid.Health)
                local maxHp = math.floor(humanoid.MaxHealth)
                esp.HP.Text = string.format("HP: %d/%d", currentHp, maxHp)
                esp.HP.Position = Vector2.new(position.X, boxY + height + 2)
                
                local hpPercent = math.clamp(currentHp / (maxHp > 0 and maxHp or 1), 0, 1)
                esp.HP.Color = Color3.fromRGB(255 * (1 - hpPercent), 255 * hpPercent, 0)
                esp.HP.Visible = true

                local className = getPlayerClass(player, character)
                esp.Class.Text = "[" .. className .. "]"
                esp.Class.Position = Vector2.new(position.X, boxY + height + 16)
                esp.Class.Visible = true
            else
                esp.Box.Visible = false
                esp.Name.Visible = false
                esp.HP.Visible = false
                esp.Class.Visible = false
            end
        else
            esp.Box.Visible = false
            esp.Name.Visible = false
            esp.HP.Visible = false
            esp.Class.Visible = false
        end
    end
end)

PlayerEspGroup:AddToggle('PlayerBoxEspToggle', {
    Text = 'Enable Player Box ESP',
    Tooltip = 'Renders 2D box with Username, HP, and Class info',
    Default = false,
    Callback = function(Value)
        boxEspEnabled = Value
    end
}):AddColorPicker('PlayerBoxEspColor', {
    Default = Color3.fromRGB(0, 255, 140),
    Title = 'Box ESP Color',
    Callback = function(Value)
        boxEspColor = Value
    end
})

--------------------------------------------------------------------------------
-- 7. TRINKET ESP & FILTERED AUTOPICKUP LOGIC
--------------------------------------------------------------------------------
local trinketEspEnabled = false
local trinketMaxDistance = 150
local showCommons = true
local showRares = true
local showUnknowns = true
local activeTrinketESP = {}

local autoPickupEnabled = false
local autoPickupConnection = nil

local function createTrinketBillboard(instance)
    if activeTrinketESP[instance] then return end
    
    local part = instance:IsA("BasePart") and instance or instance:FindFirstChildWhichIsA("BasePart", true)
    if not part then return end

    local name, color, rarity = identifyTrinket(instance)

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "TrinketESP"
    billboard.Adornee = part
    billboard.Size = UDim2.new(0, 50, 0, 15)
    billboard.StudsOffset = Vector3.new(0, 1, 0)
    billboard.AlwaysOnTop = true
    billboard.Enabled = false

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = name
    textLabel.TextColor3 = color
    textLabel.TextStrokeTransparency = 0.5
    textLabel.TextSize = 9
    textLabel.TextScaled = false
    textLabel.Font = Enum.Font.SourceSansBold
    textLabel.Parent = billboard

    billboard.Parent = part
    activeTrinketESP[instance] = { Gui = billboard, Part = part, Rarity = rarity }

    instance.AncestryChanged:Connect(function(_, parent)
        if not parent and activeTrinketESP[instance] then
            if activeTrinketESP[instance].Gui then
                activeTrinketESP[instance].Gui:Destroy()
            end
            activeTrinketESP[instance] = nil
        end
    end)
end

RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character or (Workspace:FindFirstChild("Live") and Workspace.Live:FindFirstChild(LocalPlayer.Name))
    local root = char and char:FindFirstChild("HumanoidRootPart")

    if not trinketEspEnabled or not root then
        for _, data in pairs(activeTrinketESP) do
            if data and data.Gui then data.Gui.Enabled = false end
        end
        return
    end

    for _, data in pairs(activeTrinketESP) do
        if data and data.Gui and data.Part and data.Part.Parent then
            local dist = (root.Position - data.Part.Position).Magnitude
            
            local passesFilter = false
            if data.Rarity == "Common" and showCommons then passesFilter = true end
            if data.Rarity == "Rare" and showRares then passesFilter = true end
            if data.Rarity == "Unknown" and showUnknowns then passesFilter = true end

            data.Gui.Enabled = passesFilter and (dist <= trinketMaxDistance)
        end
    end
end)

local function scanForTrinkets()
    local dinketsFolder = Workspace:WaitForChild("Dinkets", 10)
    if dinketsFolder then
        for _, child in ipairs(dinketsFolder:GetChildren()) do
            createTrinketBillboard(child)
        end
        dinketsFolder.ChildAdded:Connect(function(child)
            task.wait(0.1)
            createTrinketBillboard(child)
        end)
    end
end

task.spawn(scanForTrinkets)

WorldEspGroup:AddToggle('TrinketEspToggle', {
    Text = 'Enable Trinket ESP',
    Tooltip = 'Displays compact overhead labels for items in Workspace.Dinkets',
